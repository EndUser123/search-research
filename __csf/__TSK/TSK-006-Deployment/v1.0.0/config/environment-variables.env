# TSK-006 Persistent Learning Agent Ecosystem - Environment Variables Template
# Copy this file to .env and fill in the actual values for your environment

# Environment Configuration
TSK006_ENV=development
TSK006_DEBUG=false
TSK006_LOG_LEVEL=INFO

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tsk006
DB_USER=tsk006_user
DB_PASSWORD=your_secure_database_password_here

# Development Database (SQLite fallback)
SQLITE_DB_PATH=./data/agent_ecosystem.db

# CKS Integration Configuration
CKS_API_KEY=your_cks_api_key_here
CKS_ENDPOINT=http://cks.csf-nip.local:8080

# Staging CKS Configuration
STAGING_CKS_API_KEY=your_staging_cks_api_key_here
STAGING_CKS_ENDPOINT=http://cks-staging.csf-nip.local:8080

# Production CKS Configuration
PROD_CKS_API_KEY=your_production_cks_api_key_here
PROD_CKS_ENDPOINT=https://cks.csf-nip.production.com

# Security Configuration
SECRET_KEY=your_secret_key_here_minimum_32_characters
JWT_SECRET_KEY=your_jwt_secret_key_here_minimum_32_characters
API_KEY=your_api_key_here

# Performance Configuration
MAX_CONCURRENT_AGENTS=50
MEMORY_LIMIT_MB=2048
CACHE_SIZE=1000
CACHE_TTL=3600

# Paths Configuration
CONFIG_DIR=/etc/tsk-006
DATA_DIR=/var/lib/tsk-006
LOG_DIR=/var/log/tsk-006
ROLES_DIR=/etc/tsk-006/roles

# Monitoring Configuration
PROMETHEUS_ENDPOINT=http://prometheus:9090
PROMETHEUS_PUSH_GATEWAY=http://pushgateway:9091
GRAFANA_DASHBOARD_URL=http://grafana:3000/d/your-dashboard

# Alerting Configuration
ALERT_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
PAGERDUTY_INTEGRATION_KEY=your_pagerduty_integration_key_here
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# Logging Configuration
LOG_AGGREGATION_ENDPOINT=http://elk-stack:9200
ELK_ENDPOINT=http://elasticsearch:9200

# Backup Configuration
BACKUP_STORAGE_LOCATION=/var/backups/tsk-006
DR_BACKUP_LOCATION=s3://your-backup-bucket/tsk-006

# Security Certificates (for production)
SSL_CERT_PATH=/etc/ssl/certs/tsk-006.crt
SSL_KEY_PATH=/etc/ssl/private/tsk-006.key
POSTGRESQL_SSL_CERT=/etc/ssl/certs/postgresql.crt
POSTGRESQL_SSL_KEY=/etc/ssl/private/postgresql.key

# External Service URLs
INTERNAL_API_URL=https://internal-api.yourdomain.com
EXTERNAL_API_URL=https://api.yourdomain.com

# Redis Configuration (if using Redis for caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here
REDIS_DB=0

# SSL/TLS Configuration
SSL_ENABLED=true
SSL_VERIFY_MODE=true
TLS_VERSION=1.3

# Rate Limiting Configuration
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_BURST=200

# Session Configuration
SESSION_TIMEOUT=3600
SESSION_SECRET=your_session_secret_here
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTP_ONLY=true

# File Upload Configuration
MAX_UPLOAD_SIZE=10485760  # 10MB in bytes
UPLOAD_PATH=/var/lib/tsk-006/uploads
ALLOWED_FILE_TYPES=.txt,.json,.yaml,.yml,.md

# Email Configuration (for notifications)
SMTP_HOST=smtp.yourdomain.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_USE_TLS=true
NOTIFICATION_EMAIL_FROM=tsk-006@yourdomain.com
NOTIFICATION_EMAIL_TO=admin@yourdomain.com

# Maintenance Configuration
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE="System under maintenance. Please try again later."

# Feature Flags
EXPERIMENTAL_ROUTING=false
ADVANCED_ANALYTICS=false
BETA_FEATURES=false
DEBUG_ENDPOINTS=false

# Load Testing Configuration
LOAD_TEST_ENABLED=false
LOAD_TEST_CONCURRENT_USERS=25
LOAD_TEST_DURATION=300

# Health Check Configuration
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=10
HEALTH_CHECK_RETRIES=3

# Performance Monitoring
PERFORMANCE_MONITORING_ENABLED=true
PROFILING_ENABLED=false
METRICS_ENABLED=true
DETAILED_METRICS=false

# Compliance Configuration
AUDIT_LOGGING=true
DATA_RETENTION_DAYS=365
GDPR_COMPLIANCE=true
SOC2_COMPLIANCE=true
ISO27001_COMPLIANCE=true

# Additional Production Security
INPUT_VALIDATION=true
SQL_INJECTION_PROTECTION=true
XSS_PROTECTION=true
CSRF_PROTECTION=true
SECURE_HEADERS=true
IP_WHITELIST=
IP_BLACKLIST=

# Resource Limits
CPU_LIMIT=2000m
MEMORY_LIMIT=4Gi
CPU_REQUEST=1000m
MEMORY_REQUEST=2Gi
DISK_LIMIT=100Gi

# Deployment Configuration
DEPLOYMENT_STRATEGY=rolling
MAX_UNAVAILABLE=1
MAX_SURGE=1
REPLICAS=3

# High Availability
HIGH_AVAILABILITY_ENABLED=true
LOAD_BALANCING=true
AUTO_SCALING=false
DISASTER_RECOVERY=true
FAILOVER_ENABLED=true
GEO_REDUNDANCY=false

# Docker Configuration (if using Docker)
DOCKER_REGISTRY=your-registry.com
DOCKER_IMAGE_TAG=latest
DOCKER_PULL_POLICY=IfNotPresent
DOCKER_RESTART_POLICY=unless-stopped

# Kubernetes Configuration (if using Kubernetes)
K8S_NAMESPACE=tsk-006
K8S_SERVICE_ACCOUNT=tsk-006-service-account
K8S_CLUSTER_NAME=your-cluster-name
K8S_CONFIG_PATH=/path/to/kubeconfig

# Jenkins/CI-CD Configuration
CI_CD_WEBHOOK_URL=https://jenkins.yourdomain.com/webhook
CI_CD_BUILD_TOKEN=your_build_token_here
CI_CD_JOB_NAME=tsk-006-deployment

# Custom Configuration
CUSTOM_CONFIG_PATH=/etc/tsk-006/custom.yaml
CUSTOM_SCRIPTS_PATH=/opt/tsk-006/scripts
CUSTOM_TEMPLATES_PATH=/opt/tsk-006/templates