#!/usr/bin/env bash
# post-commit hook: surfacing contract system health after every commit
set -e

HOOKS_TOOLS="$(dirname "$0")/../tools"
if [ -f "$HOOKS_TOOLS/contract-telemetry-queries.py" ]; then
    echo ""
    echo "══ Contract System Health (post-commit) ══"
    python3 "$HOOKS_TOOLS/contract-telemetry-queries.py" dashboard 2>/dev/null | head -30
    echo ""
fi
