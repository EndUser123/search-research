#!/bin/bash
# Pre-commit hook: run gate regression tests when gate code changes,
# and validate all Python hook files for syntax errors.
#
# Bypass: git commit --no-verify (discouraged for gate changes)

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# =====================================================================
# SECTION 1: Hook correctness check (all Python files in hook directories)
# =====================================================================
HOOK_CHANGED=$(git diff --cached --name-only | grep -E '\.(py)$' | grep -E 'hooks/' || true)
if [ -n "$HOOK_CHANGED" ]; then
    echo "Hook files staged — checking Python syntax..."
    ERRORS=0
    for f in $(git diff --cached --name-only | grep -E '\.(py)$' | grep -E 'hooks/'); do
        # Only check files that are staged (not deleted)
        if git diff --cached -- "$f" | grep -q '^+'; then
            STAGED_CONTENT=$(git show ":$f" 2>/dev/null) || continue
            # Validate the *staged* bytes. py_compile with '-' reads a list of
            # filenames from stdin (not source), so it misread file content as
            # paths; ast.parse syntax-checks the source piped on stdin directly.
            RESULT=$(echo "$STAGED_CONTENT" | python -c "import ast,sys; ast.parse(sys.stdin.read())" 2>&1) && continue
            echo "  SYNTAX ERROR in staged $f:"
            echo "$RESULT" | head -3 | sed 's/^/    /'
            ERRORS=$((ERRORS + 1))
        fi
    done
    if [ $ERRORS -gt 0 ]; then
        echo ""
        echo "Pre-commit hook: $ERRORS Python syntax error(s) in staged hook files."
        echo "Fix before committing. Bypass: git commit --no-verify"
        exit 1
    fi
    echo "Hook Python syntax: OK"
fi

# =====================================================================
# SECTION 2: gitleaks secret scan on staged content (file-based)
# =====================================================================
# Scans each staged file individually to preserve file paths in findings,
# so .gitleaksignore (path-based) works correctly.
#
# Previous stdin-based scan (git diff --cached | gitleaks stdin) lost file
# paths — findings had File="" — making path-based suppression impossible
# (documented in gitleaks.toml lines 15-18). Fixed 2026-07-19: per-file
# scan so paths survive into the finding's fingerprint.
#
# Invokes gitleaks by absolute path — the winget shim is NOT on PATH in
# stripped/hook subprocess environments (verified), so a bare `gitleaks`
# call would silently no-fire. Fails OPEN (warn + skip) if the binary or
# config is missing, so a winget uninstall never hard-blocks all commits.
GITLEAKS="C:/Users/brsth/AppData/Local/Microsoft/WinGet/Links/gitleaks.exe"
GITLEAKS_CONFIG="P:/.claude/gitleaks.toml"
if [ ! -f "$GITLEAKS" ] || [ ! -f "$GITLEAKS_CONFIG" ]; then
    echo "pre-commit: gitleaks not found — secret scan SKIPPED (fail-open)."
    echo "  expected shim:   $GITLEAKS"
    echo "  expected config: $GITLEAKS_CONFIG"
else
    GL_REPORT="$(git rev-parse --git-path gitleaks-scan.json)"
    SECRETS_FOUND=0
    # Iterate staged files (relative paths from repo root). Per-file scan
    # preserves paths in findings → .gitleaksignore path-based matching works.
    while IFS= read -r f; do
        # Skip deleted files (no working-tree content to scan).
        [ -f "$f" ] || continue
        if ! "$GITLEAKS" detect --source "$f" --no-git --no-banner --config "$GITLEAKS_CONFIG" --redact -f json -r "$GL_REPORT" >/dev/null 2>&1; then
            if [ $SECRETS_FOUND -eq 0 ]; then
                echo "SECRET DETECTED in staged content — commit blocked."
            fi
            python -c "import json,sys; d=json.load(open(sys.argv[1])); [print('  %s @ %s:%s' % (x.get('RuleID','?'), x.get('File','?'), x.get('StartLine','?'))) for x in d]" "$GL_REPORT" 2>/dev/null || cat "$GL_REPORT"
            SECRETS_FOUND=$((SECRETS_FOUND + 1))
        fi
        rm -f "$GL_REPORT"
    done < <(git diff --cached --name-only)
    if [ $SECRETS_FOUND -gt 0 ]; then
        echo "False positive? Add the finding fingerprint to .gitleaksignore (repo root)."
        echo "Bypass (NOT recommended): git commit --no-verify"
        exit 1
    fi
fi

# =====================================================================
# SECTION 3: intent_artifact_alignment regression tests
# =====================================================================
ALIGN_CHANGED=$(git diff --cached --name-only | grep -i "intent_artifact_alignment" || true)

if [ -z "$ALIGN_CHANGED" ]; then
    exit 0
fi

echo "Alignment files changed, running regression tests..."

python -m pytest .claude/hooks/tests/test_intent_artifact_alignment.py -q
EXIT_CODE=$?

if [ $EXIT_CODE -ne 0 ]; then
    echo ""
    echo "GATE REGRESSION TESTS FAILED."
    echo "Commit blocked. Fix the failing tests before committing."
    echo "Bypass (not recommended): git commit --no-verify"
    exit 1
fi

echo "Alignment tests passed."
exit 0
