+@contextmanager
+def _cache_file_lock():
+    """Acquire an advisory file lock to serialize cache read-modify-write.
+
+    Two concurrent callers (e.g., two error hooks calling
+    update_provider_in_cache simultaneously) can each read the cache, each
+    add their key, and each write back ΓÇö one update silently lost (TOCTOU
+    race). This lock serializes the read-modify-write section.
+
+    The lock is held on a separate .lock file (not the cache file itself)
+    because the cache is written via atomic replace (tmp.replace), which
+    changes the inode and would break an flock on the cache file.
+
+    Platform: msvcrt.locking on Windows, fcntl.flock on POSIX. Both are
+    advisory and auto-released on process exit (no deadlock on crash).
+    """
+    lock_path = QUOTA_CACHE_PATH.with_suffix(".lock")
+    lock_path.parent.mkdir(parents=True, exist_ok=True)
+    fd = os.open(str(lock_path), os.O_CREAT | os.O_RDWR)
+
+    try:
+        if os.name == "nt":
+            import msvcrt
+            # LK_LOCK: blocking lock with retry (10/sec, 10ms intervals)
+            msvcrt.locking(fd, msvcrt.LK_LOCK, 1)
+        else:
+            import fcntl
+            fcntl.flock(fd, fcntl.LOCK_EX)
+        yield
+    finally:
+        if os.name == "nt":
+            import msvcrt
+            try:
+                # Seek back to 0 before unlocking (msvcrt requires it)
+                os.lseek(fd, 0, os.SEEK_SET)
+                msvcrt.locking(fd, msvcrt.LK_UNLCK, 1)
+            except OSError:
+                pass
+        else:
+            import fcntl
+            fcntl.flock(fd, fcntl.LOCK_UN)
+        os.close(fd)
+
