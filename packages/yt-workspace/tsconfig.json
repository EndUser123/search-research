{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "outDir": "./.output",
    "types": ["chrome", "wxt/client"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", ".output"]
}
