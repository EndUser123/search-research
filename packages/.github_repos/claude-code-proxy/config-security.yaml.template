# Security Configuration Template for claude-code-proxy
#
# This template documents security best practices for the proxy.
# Copy this to config-security.yaml and customize as needed.

# Security Configuration
security:
  # TLS Configuration for outbound connections
  tls:
    # Minimum TLS version for outbound API connections
    min_version: "TLSv1.3"

    # Certificate verification
    verify_certificates: true

    # Certificate revocation checking
    check_revocation: true

  # Logging Security
  logging:
    # Sanitize sensitive data from logs
    sanitize_requests: true

    # Sensitive patterns to redact (regex patterns)
    redact_patterns:
      - "sk-[a-zA-Z0-9]{32,}"      # OpenAI API keys
      - "sk-or-[a-zA-Z0-9]{32,}"   # OpenRouter API keys
      - "sk-ant-[a-zA-Z0-9]{32,}"  # Anthropic API keys
      - "Bearer sk-[a-zA-Z0-9]{32,}" # Bearer tokens

    # Encryption at rest (AES-256-GCM)
    encrypt_at_rest: true

    # Encryption key (use environment variable: LOG_ENCRYPTION_KEY)
    # Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
    encryption_key_env: "LOG_ENCRYPTION_KEY"

    # Log retention (auto-delete after 7 days)
    retention_days: 7

    # Enable automatic cleanup
    auto_cleanup: true

    # Cleanup schedule (cron format: daily at 2 AM)
    cleanup_schedule: "0 2 * * *"

  # File permissions (Unix-style, 600 = owner-only)
  file_permissions:
    log_files: "0600"
    config_files: "0600"
    database_files: "0600"

# Server configuration (security-focused)
server:
  # Port to listen on
  port: 3001

  # Timeouts (prevents hanging connections)
  timeouts:
    read: "10m"
    write: "10m"
    idle: "10m"

# Provider configurations (use environment variables for API keys)
providers:
  anthropic:
    base_url: "https://api.anthropic.com"
    max_retries: 3

  openai:
    base_url: "https://api.openai.com"
    # API key from: OPENAI_API_KEY environment variable
    # Store using: python credential_manager.py set OPENAI_API_KEY sk-...

  openrouter:
    base_url: "https://openrouter.ai/api/v1"
    # API key from: OPENROUTER_API_KEY environment variable

# Storage configuration
storage:
  db_path: "requests.db"
  # Enable encrypted storage
  encrypt_storage: true

# Subagent configuration
subagents:
  enable: false  # Set to true to enable subagent routing
  mappings:
    # Example mappings (configure per terminal)
    # researcher: "openrouter/x-ai/grok-code-fast-1"
    # code-reviewer: "openrouter/openai/gpt-4o"
