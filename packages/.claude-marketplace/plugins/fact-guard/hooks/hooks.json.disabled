{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(?:Edit|Write|MultiEdit)$",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PLUGIN_ROOT/hooks/fact-guard_PreToolUse.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(?:Read|Grep|Bash)$",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PLUGIN_ROOT/hooks/fact-guard_PostToolUse.py\""
          }
        ]
      }
    ]
  }
}