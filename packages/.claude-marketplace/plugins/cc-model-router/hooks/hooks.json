{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^.*$",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PLUGIN_ROOT/hooks/sessionstart/model_router_init.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "^.*$",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PLUGIN_ROOT/hooks/userpromptsubmit/model_router_classify.py\"",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "python \"$CLAUDE_PLUGIN_ROOT/hooks/userpromptsubmit/model_router_apply.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
