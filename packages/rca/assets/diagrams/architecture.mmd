flowchart LR

    %% rca - Architecture

    %% Modern color scheme
    classDef primary fill:#dbeafe,stroke:#2563eb,stroke-width:2px,color:#1e293b,rx:8px
    classDef accent fill:#cffafe,stroke:#06b6d4,stroke-width:2px,color:#1e293b,rx:8px
    classDef success fill:#d1fae5,stroke:#10b981,stroke-width:2px,color:#1e293b,rx:8px
    classDef warning fill:#fef3c7,stroke:#f59e0b,stroke-width:2px,color:#1e293b,rx:8px
    classDef container fill:#f8fafc,stroke:#94a3b8,stroke-width:1px,color:#1e293b,stroke-dasharray: 5 5

    subgraph rca["Architecture"]
        direction LR

        main["Main"]:::primary
        analyzer["Analyzer"]:::accent
        hypothesisengine["HypothesisEngine"]:::success
        verifier["Verifier"]:::warning
        reporter["Reporter"]:::success

    end

    %% Data flow connections
        main --> analyzer
        analyzer --> hypothesisengine
        hypothesisengine --> verifier
        verifier --> reporter

    %% Feedback loop
        reporter -.->|feedback| main

    %% Link styling
    linkStyle default stroke:#64748b,stroke-width:2px
    linkStyle 1 stroke:#2563eb,stroke-width:3px