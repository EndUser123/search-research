"""Tests for HyDE query enhancement."""

import pytest

from search_research.hyde import (
    _extract_key_phrases_fallback,
    apply_hyde,
    enhance_query,
    extract_key_phrases,
    generate_hypothetical_doc,
)


class TestGenerateHypotheticalDoc:
    """Tests for generate_hypothetical_doc."""

    def test_empty_query_raises(self):
        """Test that empty query raises ValueError."""
        with pytest.raises(ValueError, match="Query cannot be empty"):
            generate_hypothetical_doc("")

    def test_whitespace_query_raises(self):
        """Test that whitespace-only query raises ValueError."""
        with pytest.raises(ValueError, match="Query cannot be empty"):
            generate_hypothetical_doc("   ")

    def test_no_api_key_raises(self, monkeypatch):
        """Test that missing API key raises RuntimeError."""
        monkeypatch.delenv("ANTHROPIC_API_KEY", raising=False)
        with pytest.raises(RuntimeError, match="ANTHROPIC_API_KEY not set"):
            generate_hypothetical_doc("FastAPI patterns")


class TestExtractKeyPhrases:
    """Tests for extract_key_phrases."""

    def test_empty_doc_raises(self):
        """Test that empty doc raises ValueError."""
        with pytest.raises(ValueError, match="Document cannot be empty"):
            extract_key_phrases("")

    def test_fallback_extraction(self):
        """Test fallback extraction without Claude API."""
        doc = "FastAPI supports async operations using async/await syntax for high performance."
        phrases = _extract_key_phrases_fallback(doc)
        assert isinstance(phrases, list)
        assert len(phrases) >= 0  # May be empty if simple heuristic fails

    def test_fallback_returns_list(self):
        """Test that fallback always returns a list."""
        phrases = _extract_key_phrases_fallback("Some text here.")
        assert isinstance(phrases, list)


class TestEnhanceQuery:
    """Tests for enhance_query."""

    def test_empty_query_raises(self):
        """Test that empty query raises ValueError."""
        with pytest.raises(ValueError, match="Query cannot be empty"):
            enhance_query("", ["phrase1", "phrase2"])

    def test_no_phrases_returns_original(self):
        """Test that empty phrases list returns original query."""
        query = "FastAPI patterns"
        enhanced = enhance_query(query, [])
        assert enhanced == query

    def test_with_phrases_combines(self):
        """Test that query is combined with phrases."""
        query = "FastAPI async"
        phrases = ["async operations", "await syntax"]
        enhanced = enhance_query(query, phrases)
        assert "FastAPI async" in enhanced
        assert "async operations" in enhanced
        assert "await syntax" in enhanced

    def test_whitespace_query_trimmed(self):
        """Test that whitespace is trimmed from query."""
        query = "  FastAPI patterns  "
        phrases = ["async"]
        enhanced = enhance_query(query, phrases)
        assert enhanced.startswith("FastAPI")


class TestApplyHyde:
    """Tests for apply_hyde."""

    def test_empty_query_returns_gracefully(self):
        """Test that empty query is handled gracefully."""
        # apply_hyde catches ValueError and returns original query
        enhanced, applied = apply_hyde("")
        # Should return gracefully with empty string and False
        assert enhanced == ""
        assert applied is False

    def test_returns_tuple(self, monkeypatch):
        """Test that apply_hyde returns a tuple."""
        monkeypatch.delenv("ANTHROPIC_API_KEY", raising=False)
        enhanced, applied = apply_hyde("FastAPI patterns")
        assert isinstance(enhanced, str)
        assert isinstance(applied, bool)

    def test_no_api_key_fallback(self, monkeypatch):
        """Test graceful degradation when API key is missing."""
        monkeypatch.delenv("ANTHROPIC_API_KEY", raising=False)
        query = "FastAPI patterns"
        enhanced, applied = apply_hyde(query)
        assert enhanced == query
        assert applied is False

    def test_claude_error_fallback(self, monkeypatch):
        """Test graceful degradation when Claude API fails."""
        monkeypatch.setenv("ANTHROPIC_API_KEY", "fake-key")
        query = "FastAPI patterns"
        # Should not raise exception, but return original query
        enhanced, applied = apply_hyde(query)
        assert isinstance(enhanced, str)
        assert isinstance(applied, bool)


class TestHyDEIntegration:
    """Integration tests for HyDE pipeline."""

    def test_full_pipeline_with_mock(self, monkeypatch):
        """Test full HyDE pipeline with mocked Claude API."""
        # This test verifies the pipeline structure even without real API
        monkeypatch.setenv("ANTHROPIC_API_KEY", "fake-key")

        query = "FastAPI async patterns"

        # Should not crash, should return gracefully
        enhanced, applied = apply_hyde(query)

        assert isinstance(enhanced, str)
        assert isinstance(applied, bool)
        # If API failed (which it will with fake key), should return original
        if not applied:
            assert enhanced == query

    def test_hyde_is_optional(self):
        """Test that HyDE enhancement is optional."""
        query = "FastAPI patterns"

        # HyDE should not be required for basic functionality
        # This test verifies the system works without HyDE
        assert isinstance(query, str)
        assert len(query) > 0
