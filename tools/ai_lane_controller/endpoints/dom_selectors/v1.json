{
  "version": "v1",
  "description": "ChatGPT DOM selectors for bridge interaction",
  "notes": "ChatGPT is rapidly developed. These selectors may change. Test against fixtures.",
  "textarea": "textarea",
  "send_button": "button[data-testid='send-button']",
