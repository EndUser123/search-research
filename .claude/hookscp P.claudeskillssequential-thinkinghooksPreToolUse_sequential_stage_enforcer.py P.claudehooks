#!/usr/bin/env python3
"""
PostToolUse Hook: Sequential Stage Tracker

Tracks stage progression after tool execution in interactive mode.

This hook:
1. Runs after each tool execution during an active pipeline
2. Detects if the response indicates stage completion
3. Updates pipeline state and returns next stage's framework
4. Returns empty dict if no stage detected or pipeline complete

Only active in INTERACTIVE mode (THINK: prefix). Auto mode gets all
frameworks at once and doesn't need stage tracking.
"""
from __future__ import annotations

import json
import os
import sys
from pathlib import Path
from typing import Any

# Configuration
ENABLED = os.environ.get("SEQUENTIAL_THINKING_ENABLED", "1").lower() in ("1", "true", "yes", "on")
DEBUG = os.environ.get("CSF_HOOK_DEBUG", "0") == "1"

# Add paths for imports
SKILLS_DIR = Path(__file__).resolve().parent.parent
HOOKS_DIR = SKILLS_DIR.parent / "hooks"
sys.path.insert(0, str(HOOKS_DIR))

# Import state manager and detection
from skills.sequential_thinking.hooks.state_manager_sequential_thinking import (
    get_execution_mode,
    read_state,
)
from skills.sequential_thinking.lib.pipeline_engine import SequentialThinkingPipeline
from skills.sequential_thinking.lib.stage_detection import (
    detect_stage_from_response,
    is_completion_claim,
)


def post_tool_use(tool_name: str, tool_input: dict[str, Any], tool_result: dict[str, Any]) -> dict[str, Any]:
    """
    Track stage completion after tool execution.

    Args:
        tool_name: Name of the tool that was executed
        tool_input: Input parameters passed to the tool
        tool_result: Result returned by the tool

    Returns:
        {"additionalContext": "..."} if stage completed and next stage ready
        {} otherwise
    """
    if not ENABLED:
        return {}

    # Check if there's an active pipeline
    state = read_state()
    if state is None:
        return {}

    # Only track in interactive mode
    mode = get_execution_mode()
    if mode is None or mode.value != "interactive":
        return {}

    # Check if tool execution failed - don't advance on failure
    if tool_name == "Bash":
        exit_code = tool_result.get("exitCode", 0)
        if exit_code != 0:
            if DEBUG:
                print(f"[DEBUG:sequential_stage_tracker] Bash failed with exit code {exit_code}, not advancing stage", file=sys.stderr)
            return {}
    elif "error" in tool_result:
        if DEBUG:
            print(f"[DEBUG:sequential_stage_tracker] Tool {tool_name} returned error, not advancing stage", file=sys.stderr)
        return {}

    # Get the model's response from the result
    # The response is typically in the tool result's output
    response_text = ""

    # Different tools store output differently
    if tool_name == "Bash":
        # For Bash, we need to look at stdout/stderr
        response_text = tool_result.get("stdout", "") + tool_result.get("stderr", "")
    elif "output" in tool_result:
        response_text = str(tool_result.get("output", ""))
    elif "result" in tool_result:
        response_text = str(tool_result.get("result", ""))
    elif "content" in tool_result:
        response_text = str(tool_result.get("content", ""))

    # If no response text found, we can't detect stage completion
    if not response_text or len(response_text.strip()) < 10:
        return {}

    # Create pipeline instance and advance stage
    pipeline = SequentialThinkingPipeline()

    # Check for completion claim first
    if is_completion_claim(response_text):
        if DEBUG:
            print(f"[DEBUG:sequential_stage_tracker] Completion claim detected, pipeline ending", file=sys.stderr)
        return {}

    # Try to advance to next stage
    next_context = pipeline.advance_stage(response_text)

    if next_context:
        if DEBUG:
            current_stage = (read_state() or {}).get("current_stage", 1)
            print(f"[DEBUG:sequential_stage_tracker] Advanced to Stage {current_stage}", file=sys.stderr)

        return next_context

    return {}


def main():
    """Direct execution for testing."""
    try:
        # Read input from stdin
        input_data = json.loads(sys.stdin.read())

        tool_name = input_data.get("toolName", "")
        tool_input = input_data.get("toolInput", {})
        tool_result = input_data.get("toolResult", {})

        result = post_tool_use(tool_name, tool_input, tool_result)
        print(json.dumps(result))

    except (json.JSONDecodeError, KeyError):
        print(json.dumps({}))


if __name__ == "__main__":
    main()
