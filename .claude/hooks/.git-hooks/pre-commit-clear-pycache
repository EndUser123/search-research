#!/usr/bin/env python3
"""
Git Pre-Commit Hook: Python Bytecode Cache Invalidation

Automatically clears Python bytecode caches (.pyc, __pycache__) for hooks
before committing. This prevents stale bytecode from being committed and
ensures hooks run with fresh bytecode after pulls.

Prevents recurrence of bugfixes.md issue: "Redis Import Crash - Python 3.14
Incompatibility" where stale .pyc files caused import failures.

Integration:
- Copy or symlink to .git/hooks/pre-commit
- Make executable: chmod +x .git/hooks/pre-commit
- Automatically runs before every git commit

Performance:
- Typical execution: <100ms
- Only affects .claude/hooks/ directory
- Fails open (doesn't block commit if cache clearing fails)
"""

from __future__ import annotations

import os
import shutil
import sys
from pathlib import Path

# Hooks directory to clean
HOOKS_DIR = Path(__file__).resolve().parent.parent / "hooks"


def find_pycache_dirs(root: Path) -> list[Path]:
    """Find all __pycache__ directories recursively."""
    if not root.exists():
        return []

    pycache_dirs = []
    for item in root.rglob("__pycache__"):
        if item.is_dir():
            pycache_dirs.append(item)

    return pycache_dirs


def find_pyc_files(root: Path) -> list[Path]:
    """Find all .pyc files recursively."""
    if not root.exists():
        return []

    pyc_files = []
    for pattern in ["*.pyc", "*.pyo"]:
        pyc_files.extend(root.rglob(pattern))

    return pyc_files


def clear_path(path: Path) -> bool:
    """Clear a directory or file. Returns True if successful."""
    try:
        if path.is_dir():
            shutil.rmtree(path)
        elif path.is_file():
            path.unlink()
        return True
    except Exception:
        # Fail open - don't block commit if cache clearing fails
        return False


def main() -> int:
    """Clear Python bytecode caches from hooks directory."""
    if not HOOKS_DIR.exists():
        # Hooks directory doesn't exist yet - nothing to clean
        return 0

    # Find all bytecode artifacts
    pycache_dirs = find_pycache_dirs(HOOKS_DIR)
    pyc_files = find_pyc_files(HOOKS_DIR)

    # Clear them
    cleared = 0
    for path in pycache_dirs + pyc_files:
        if clear_path(path):
            cleared += 1

    # Optional: Log if anything was cleared
    if cleared > 0 and os.environ.get("GIT_PYCACHE_CLEANUP_VERBOSE"):
        print(f"[pre-commit] Cleared {cleared} bytecode artifacts from {HOOKS_DIR}")

    return 0


if __name__ == "__main__":
    sys.exit(main())
