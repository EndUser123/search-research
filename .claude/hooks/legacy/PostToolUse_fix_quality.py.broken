#!/usr/bin/env python3
"""
PostToolUse hook: FIX QUALITY gate

Runs after Edit/Write operations to detect band-aid patterns
that suppress symptoms instead of fixing root causes.
"""

from __future__ import annotations

import logging
import sys
from pathlib import Path
from typing import Any

# Add src to path for imports
src_path = Path(__file__).parent.parent.parent / "__csf" / "src"
if str(src_path) not in sys.path:
    sys.path.insert(0, str(src_path))

# check_fix_quality module is not available - inline implementation
# TODO: Create unified quality router

# Configure logging
logger = logging.getLogger(__name__)

# Tools that modify code and should be checked for fix quality
_QUALITY_CHECKED_TOOLS = frozenset({"Edit", "Write"})


def post_tool_use(
    result: dict[str, Any],
    tool_name: str,
    input_args: dict[str, Any],
    context: dict[str, Any],
) -> dict[str, Any] | None:
    """
    Hook that runs after tool use to check fix quality.

    Args:
        result: The result from the tool execution
        tool_name: Name of the tool that was used (Edit, Write, etc.)
        input_args: Arguments passed to the tool
        context: Additional context including response_text

    Returns:
        dict with "should_block": True and block message if should block,
        None if the fix passes quality check
    """
    # Only run for Edit or Write operations
    if tool_name not in _QUALITY_CHECKED_TOOLS:
        return None

    # Get the response text from context
    response_text = context.get("response_text", "")
    if not response_text:
        return None

    try:
        # Call check_fix_quality to assess the response
        quality_result = check_fix_quality(response_text)

        # If should_block is True, return block dict
        if quality_result.get("should_block"):
            return {
                "should_block": True,
                "block_message": quality_result.get(
                    "block_reason", "Fix quality check failed"
                ),
            }

    except Exception as e:
        # Log error but don't block - hook failures shouldn't break operations
        logger.debug(f"Fix quality check failed: {e}")

    # Pass silently when should_block is False or on error
    return None


__all__ = ["post_tool_use"]
