#!/usr/bin/env python3
"""Pre-commit hook: Validate Python syntax before allowing commits.

This hook runs py_compile on all staged .py files and blocks the commit
if any syntax errors are found.

Installation:
    ln -s P:/.claude/hooks/pre-commit-syntax-check .git/hooks/pre-commit

Or add to .git/hooks/pre-commit:
    #!/bin/sh
    python P:/.claude/hooks/pre-commit-syntax-check
"""

from __future__ import annotations

import os
import subprocess
import sys
from pathlib import Path


def get_staged_python_files() -> list[Path]:
    """Get list of staged Python files."""
    try:
        # Get list of staged files
        result = subprocess.run(
            ["git", "diff", "--cached", "--name-only", "--diff-filter=ACM"],
            capture_output=True,
            text=True,
            check=True,
        )

        staged_files = []
        for line in result.stdout.strip().split("\n"):
            if line.strip().endswith(".py"):
                file_path = Path(line.strip())
                if file_path.exists():
                    staged_files.append(file_path)

        return staged_files
    except subprocess.CalledProcessError:
        return []


def validate_syntax(files: list[Path]) -> tuple[bool, list[str]]:
    """Validate Python syntax for all files."""
    import py_compile

    errors = []

    for file_path in files:
        try:
            py_compile.compile(file_path, doraise=True)
        except py_compile.PyCompileError as e:
            errors.append(f"{file_path}:\n{e}")

    return (len(errors) == 0, errors)


def main():
    """Pre-commit hook entry point."""
    staged_files = get_staged_python_files()

    if not staged_files:
        # No Python files staged, allow commit
        sys.exit(0)

    print(f"🔍 Validating syntax for {len(staged_files)} staged Python files...")

    all_valid, errors = validate_syntax(staged_files)

    if not all_valid:
        print("\n❌ Syntax validation failed - commit blocked\n")
        print("The following files have syntax errors:\n")
        for error in errors:
            print(error)
            print()

        print("\nFix the syntax errors before committing.")
        print("To skip this check (not recommended), use: git commit --no-verify")
        sys.exit(1)

    print(f"✅ All {len(staged_files)} files validated successfully")
    sys.exit(0)


if __name__ == "__main__":
    main()
