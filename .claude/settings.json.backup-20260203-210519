  "enabledPlugins": {},
  "tdd": {
    "enforcement_mode": "enforced",
    "level": 1,
    "evidence_enabled": true,
    "tiers": {
      "TIER0": {
        "enabled": true,
        "action": "block",
        "files": [
          "**/*.py",
          "**/*.js",
          "**/*.ts",
          "**/*.java",
          "**/*.c",
          "**/*.cpp",
          "**/*.rs",
          "**/*.go"
        ],
        "description": "Critical components - TDD mandatory"
      },
      "TIER1": {
        "enabled": true,
        "action": "block",
        "files": [
          "src/**",
          "lib/**",
          "app/**"
        ],
        "description": "Production code - TDD mandatory"
      },
      "TIER2": {
        "enabled": true,
        "action": "warn",
        "files": [
          "experimental/**",
          "prototype/**"
        ],
        "description": "Experimental code - TDD advisory"
      },
      "TIER3": {
        "enabled": false,
        "files": [
          "docs/**",
          "tests/**",
          "**/*.md",
          "**/*.txt",
          "**/*.json"
        ],
        "description": "Documentation and tests - No TDD enforcement"
      }
    },
    "exclusions": [
      "**/__pycache__/**",
      "**/node_modules/**",
      "**/.git/**",
      "**/venv/**",
      "**/env/**",
      "**/build/**",
      "**/dist/**"
