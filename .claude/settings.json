    "DELEGATION_GATE_ENABLED": "false",
    "VERIDICAL_GATE_ENABLED": "true",
    "CKS_KNOWLEDGE_SEMANTIC": "false"
  },
  "includeCoAuthoredBy": true,
  "permissions": {
    "allow": [
      "Bash",
      "Skill",
      "Read",
      "Write",
      "Edit",
      "MultiEdit",
      "Read(P:/**)",
      "PowerShell(python *)",
      "Write(P:/.claude/**)",
      "Edit(P:/.claude/**)",
      "mcp__plugin_serena_serena__find_symbol",
      "mcp__plugin_serena_serena__read_file",
      "mcp__plugin_serena_serena__search_for_pattern",
      "mcp__brave__brave_web_search",
      "mcp__search-research__unified_search",
      "mcp__aid__distill_file",
      "mcp__search-research__cks_search",
      "mcp__search-research__cks_search_semantic",
      "mcp__tavily-mcp__tavily_search",
      "mcp__web-reader__webReader",
      "mcp__tavily-mcp__tavily_extract",
      "mcp__exa__web_search_exa",
      "mcp__plugin_context7_context7__resolve-library-id",
      "Bash(git -C *)",
      "Bash(curl -s *)",
      "Bash(python3 *)",
      "Write(P:/.claude/.evidence/**)",
      "Write(P:/.claude/.staging/**)",
      "Write(P:/.claude/plans/**)",
      "Write(P:/.claude/.artifacts/**)",
      "Edit(P:/.claude/.artifacts/**)",
      "Edit(P:/packages/.claude-marketplace/**)",
      "Write(P:/packages/.claude-marketplace/**)",
      "Read(C:/Users/brsth/Downloads/**)",
      "Write(C:/Users/brsth/Downloads/**)",
      "Edit(C:/Users/brsth/Downloads/**)",
      "Read(P:/.claude/**/__pycache__/**)",
      "Write(P:/.claude/**/__pycache__/**)",
      "Edit(P:/.claude/**/__pycache__/**)",
      "Read(P:/packages/**/__pycache__/**)",
      "Write(P:/packages/**/__pycache__/**)",
      "Edit(P:/packages/**/__pycache__/**)",
      "Bash(rm -f P:/.claude/**/__pycache__/**)",
      "Bash(rm -rf P:/.claude/**/__pycache__/**)",
      "Bash(rm -f P:/packages/**/__pycache__/**)",
      "Bash(rm -rf P:/packages/**/__pycache__/**)",
      "Bash(powershell*)",
      "Bash(pwsh*)"
    ],
    "ask": [
      "Bash(cmd /*)",
      "Bash(perl*)",
      "Bash(ruby*)",
      "Bash(php*)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(del /f /q C:\\*)",
      "Bash(sudo rm -rf /*)",
      "Bash(dd if=/dev/zero of=/dev/sda)",
      "Bash(format c:)",
      "Bash(shutdown /s /t 0)",
      "Bash(reboot)",
      "Bash(chmod -R 777 /)",
      "Bash(curl | bash)",
      "Bash(wget | bash)",
      "Bash(*Remove-Item*-Recurse*-Force*)",
      "Bash(*Remove-Item*-Force*-Recurse*)",
      "Bash(*rd /s*)",
      "Bash(*rmdir /s*)",
      "Bash(*Format-Volume*)",
      "Bash(*Clear-Disk*)",
      "Bash(*Restart-Computer*)",
      "Bash(*Stop-Computer*)",
      "Bash(*icacls*Everyone*)",
      "Bash(*Invoke-Expression*)",
      "Bash(*iex*)",
      "Bash(*Invoke-WebRequest*|*iex*)",
      "Bash(*irm*|*iex*)",
      "Bash(echo * > P:/*.py)",
      "Bash(echo * > P:/*.PY)",
      "Write(../*)",
      "Write(./../**)",
      "Edit(../*)",
      "Edit(./../**)",
      "Write(/root/**)",
      "Write(/etc/**)",
      "Write(/usr/bin/**)",
      "Write(C:/Windows/**)",
      "Write(C:/Program Files/**)",
      "Bash(rm -rf .git*)",
      "Bash(npm publish*)",
      "Bash(cat .env*)"
    ]
  },
  "enabledMcpjsonServers": [],
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import sys; sys.path.insert(0, 'P:/.claude/hooks'); from __lib.hook_importer import HookImporter; importer = HookImporter('P:/.claude/hooks'); result = importer.execute_hook('UserPromptSubmit'); sys.exit(0 if result.get('ok') else result.get('exit_code', 1))\"",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "python P:/packages/.claude-marketplace/plugins/skill-guard/src/skill_guard/__lib/router.py UserPromptSubmit",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python P:/.claude/hooks/log_hook.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(?:Skill|Bash|mcp__.*)$",
        "hooks": [
          {
            "type": "command",
            "command": "python P:/.claude/hooks/tool_availability_checker.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python P:/.claude/hooks/PreToolUse.py",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python P:/packages/.claude-marketplace/plugins/skill-guard/src/skill_guard/__lib/router.py PreToolUse",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python P:/packages/.claude-marketplace/plugins/cc-aca-epistemic/__lib/router.py PreToolUse",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "python P:/.claude/hooks/log_hook.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(?:Edit|Write|MultiEdit)$",
        "hooks": [
          {
            "type": "command",
            "command": "python P:/.claude/hooks/__lib/hook_runner.py P:/.claude/hooks/anti_lazy_diff_nudge.py",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python P:/.claude/hooks/__lib/hook_runner.py P:/.claude/hooks/self_verification_gate.py",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python P:/.claude/hooks/__lib/hook_runner.py P:/.claude/hooks/PostToolUse_hook_import_health.py",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python P:/.claude/hooks/__lib/hook_runner.py P:/.claude/hooks/PostToolUse_bash_syntax_gate.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python P:/.claude/hooks/__lib/hook_runner.py P:/.claude/hooks/PostToolUse.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^(?:Write|Edit|MultiEdit)$",
        "hooks": [
          {
            "type": "command",
            "command": "python P:/.claude/hooks/__lib/hook_runner.py P:/.claude/hooks/PostToolUse_claim_verifier_smoke.py",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python P:/.claude/hooks/log_hook.py"
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python P:/packages/.claude-marketplace/plugins/cc-aca-observability/__lib/router.py PostToolUse",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python P:/packages/.claude-marketplace/plugins/cc-aca-epistemic/__lib/router.py PostToolUse",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python \"P:/packages/.claude-marketplace/plugins/snapshot/scripts/hooks/snapshot_PreCompact.py\"",
            "timeout": 45
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python P:/.claude/hooks/Notification_voice_hook.py",
            "timeout": 3
          },
          {
            "type": "command",
            "command": "python P:/.claude/hooks/log_hook.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python P:/.claude/hooks/__lib/hook_runner.py P:/.claude/hooks/Stop.py --timeout 10.0",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python P:/packages/.claude-marketplace/plugins/skill-guard/src/skill_guard/__lib/router.py Stop",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python P:/.claude/hooks/log_hook.py"
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": []
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python P:/packages/.claude-marketplace/plugins/cc-skills-sdlc/skills/go/scripts/go_continuation_gate.py"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import sys; sys.path.insert(0, 'P:/.claude/hooks'); from __lib.hook_importer import HookImporter; importer = HookImporter('P:/.claude/hooks'); result = importer.execute_hook('SessionStart', timeout=45.0); sys.exit(0 if result.get('ok') else result.get('exit_code', 1))\"",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python P:/packages/.claude-marketplace/plugins/cc-aca-observability/__lib/router.py SessionStart",
            "timeout": 60
          }
        ]
      }
    ],
    "SessionEnd": [],
    "SubagentStop": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python P:/.claude/hooks/SubagentStop_cjk_drift_detector.py",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "snapshot@local": true
  },
  "mcpServers": {},
  "tdd": {
    "enforcement_mode": "enforced",
    "level": 1,
    "evidence_enabled": true,
    "tiers": {
      "TIER0": {
        "enabled": true,
        "action": "block",
        "files": [
          "**/*.py",
          "**/*.js",
          "**/*.ts",
          "**/*.java",
          "**/*.c",
          "**/*.cpp",
          "**/*.rs",
          "**/*.go"
        ],
        "description": "Critical components - TDD mandatory"
      },
      "TIER1": {
        "enabled": true,
        "action": "block",
        "files": [
          "src/**",
          "lib/**",
          "app/**"
        ],
        "description": "Production code - TDD mandatory"
      },
      "TIER2": {
        "enabled": true,
        "action": "warn",
        "files": [
          "experimental/**",
          "prototype/**"
        ],
        "description": "Experimental code - TDD advisory"
      },
      "TIER3": {
        "enabled": false,
        "files": [
          "docs/**",
          "tests/**",
          "**/*.md",
          "**/*.txt",
          "**/*.json"
        ],
        "description": "Documentation and tests - No TDD enforcement"
      }
    },
    "exclusions": [
      "**/__pycache__/**",
      "**/node_modules/**",
      "**/.git/**",
      "**/venv/**",
      "**/env/**",
      "**/build/**",
      "**/dist/**"
    ]
  },
  "tdd95": {
    "enabled": true,
    "enforcement_mode": "smart",
    "autoscaffold": {
      "enabled": false,
      "on_create": true,
      "on_edit_missing": true,
      "template": "minimal"
    },
    "gate": {
      "check_test_exists": true,
      "check_test_recency_minutes": 10,
      "check_test_passing": false,
      "block_on_missing": "block",
      "block_on_stale": "suggest"
    },
    "exemptions": {
      "patterns": [
        "**/__init__.py",
        "**/conftest.py",
        "**/tests/**/*.py",
        "**/test/**/*.py",
        "**/*.md",
        "**/*.txt",
        "**/*.json",
        "**/*.yaml",
        "**/*.yml",
        "**/*.toml",
        "**/*.ini"
      ],
      "directories": [
        "docs",
        "tests",
        "test",
        ".git",
        "__pycache__",
        "node_modules",
        "venv",
        "env",
        "build",
        "dist"
      ]
    },
    "tiers": {
      "TIER0": {
        "enabled": true,
        "files": [
          "**/*.py",
          "**/*.ts",
          "**/*.tsx"
        ],
        "action": "scaffold",
        "description": "Core implementation files - auto-scaffold tests"
      },
      "TIER1": {
        "enabled": true,
        "files": [
          "src/**",
          "lib/**",
          "app/**"
        ],
        "action": "scaffold",
        "description": "Production code - auto-scaffold tests"
      },
      "TIER2": {
        "enabled": false,
        "files": [
          "experimental/**",
          "prototype/**"
        ],
        "action": "optional",
        "description": "Experimental code - TDD optional"
      }
    },
    "critical_hooks": {
      "enabled": true,
      "require_integration_tests": true,
      "manifest_path": "P:/.claude/hooks/critical_hooks.json"
    }
  },
  "cks_integration": {
    "enabled": true,
    "version": "1.0.0",
    "feature_toggles": {
      "context_injection": true,
      "solution_storage": true,
      "memory_search": true,
      "session_continuity": true
    },
    "memory_config": {
      "max_memories": 5,
      "similarity_threshold": 0.7,
      "context_length_limit": 1500,
      "search_timeout_ms": 3000
    },
    "storage_config": {
      "auto_store_tasks": true,
      "storage_timeout_ms": 2000,
      "async_storage": true,
      "min_solution_length": 10
    },
    "error_handling": {
      "fallback_enabled": true,
      "graceful_degradation": true,
      "timeout_handling": "continue",
      "log_errors": true
    },
    "monitoring": {
      "track_usage": true,
      "performance_metrics": true,
      "success_rates": true,
      "log_directory": ".claude/hooks/logs/cks_integration"
    }
  },
  "debugrca": {
    "saturation_thresholds": {
      "technical": 0.85,
      "balanced": 0.75,
      "preference": 0.7,
      "default": 0.75
    },
    "phase_persistence": {
      "state_dir": "P:/.claude/state/debugrca/",
      "enabled": true
    },
    "hypothesis_scoring": {
      "reproducibility_weight": 0.3,
      "recency_weight": 0.2,
      "impact_weight": 0.5
    }
  }
}