# Sapling Configuration File
# This file enables the CSF NIP pre-commit extension for Sapling SCM

[extensions]
# Enable CSF NIP pre-commit extension
csf-nip-precommit = __csf.nip/sapling_precommit_extension.py

# Additional useful extensions
tweakdefaults =
blackbox =
morestatus =

[ui]
# User configuration (can be overridden)
username = CSF NIP Developer <dev@csf-nip.local>

[hooks]
# Pre-commit hook configuration
precommit.enabled = true
precommit.parallel = true
precommit.timeout = 300

# Specific hook settings
[hooks.import_validator]
enabled = true
timeout = 30

[hooks.python_security]
enabled = true
timeout = 20

[hooks.taskmaster_schema_validator]
enabled = true
timeout = 15

[hooks.constitutional_compliance]
enabled = true
timeout = 25

[alias]
# Create convenient aliases
ci = commit
precommit-check = python __csf.nip/sapling_precommit_extension.py
