"""
Graceful interruption handling for yt-fts downloads.

Provides signal handling, clean thread shutdown, and partial progress saving
when downloads are interrupted by users (Ctrl+C) or other signals.
"""

import signal
import threading
import time
from concurrent.futures import ThreadPoolExecutor
from contextlib import contextmanager
from typing import Callable, Dict, List, Optional, Any
from dataclasses import dataclass, field

from rich.console import Console


@dataclass
class InterruptionState:
    """Tracks the state of the download process during interruption."""
    interrupted: bool = False
    interruption_time: Optional[float] = None
    shutdown_initiated: bool = False
    cleanup_completed: bool = False
    progress_data: Dict[str, Any] = field(default_factory=dict)
    active_executors: List[ThreadPoolExecutor] = field(default_factory=list)
    active_threads: List[threading.Thread] = field(default_factory=list)
    cleanup_callbacks: List[Callable] = field(default_factory=list)

    def add_executor(self, executor: ThreadPoolExecutor) -> None:
        """Register an active executor for cleanup."""
        self.active_executors.append(executor)

    def add_thread(self, thread: threading.Thread) -> None:
        """Register an active thread for tracking."""
        self.active_threads.append(thread)

    def add_cleanup_callback(self, callback: Callable) -> None:
        """Register a cleanup callback to be called on interruption."""
        self.cleanup_callbacks.append(callback)

    def update_progress(self, channel: str, completed: int, total: int,
                       video_id: Optional[str] = None) -> None:
        """Update progress tracking for partial saving."""
        if channel not in self.progress_data:
            self.progress_data[channel] = {
                'completed': 0,
                'total': total,
                'videos': []
            }

        self.progress_data[channel]['completed'] = completed
        self.progress_data[channel]['total'] = total

        if video_id and video_id not in self.progress_data[channel]['videos']:
            self.progress_data[channel]['videos'].append(video_id)


class GracefulInterruptHandler:
    """
    Handles graceful interruption of download processes.

    Provides signal handling for Ctrl+C and other interruption signals,
    ensuring clean shutdown of threads, executors, and proper saving
    of partial progress.
    """

    def __init__(self, console: Optional[Console] = None):
        self.console = console or Console()
        self.state = InterruptionState()
        self.original_handlers = {}
        self.shutdown_lock = threading.Lock()

    def __enter__(self):
        """Context manager entry - register signal handlers."""
        self.register_signal_handlers()
        return self

    def __exit__(self, exc_type, exc_val, exc_tb):
        """Context manager exit - restore signal handlers and cleanup."""
        self.restore_signal_handlers()
        if self.state.interrupted:
            self._perform_graceful_shutdown()
        return False  # Don't suppress exceptions

    def register_signal_handlers(self) -> None:
        """Register signal handlers for graceful interruption."""
        signals_to_handle = [signal.SIGINT, signal.SIGTERM]

        # Only register signals that exist on the current platform
        for sig in signals_to_handle:
            try:
                if hasattr(signal, sig.name):
                    self.original_handlers[sig] = signal.signal(sig, self._signal_handler)
            except (AttributeError, ValueError, OSError):
                # Signal not available on this platform or already registered
                pass

    def restore_signal_handlers(self) -> None:
        """Restore original signal handlers."""
        for sig, handler in self.original_handlers.items():
            try:
                if hasattr(signal, sig.name):
                    signal.signal(sig, handler)
            except (AttributeError, ValueError, OSError):
                pass
        self.original_handlers.clear()

    def _signal_handler(self, signum: int, frame) -> None:
        """Handle interruption signals."""
        with self.shutdown_lock:
            if self.state.interrupted:
                # Already handling interruption - force exit
                self.console.print("\n[red]🛑 Force exit requested. Terminating immediately...[/red]")
                import os
                os._exit(1)

            self.state.interrupted = True
            self.state.interruption_time = time.time()

            signal_name = signal.Signals(signum).name if hasattr(signal, 'Signals') else str(signum)
            self.console.print(f"\n[yellow]⚠️  Download interrupted by {signal_name} (Ctrl+C)[/yellow]")
            self.console.print("[yellow]🔄 Initiating graceful shutdown...[/yellow]")

    def check_interruption(self) -> bool:
        """Check if interruption has been requested."""
        return self.state.interrupted

    def should_continue(self) -> bool:
        """Check if the operation should continue (not interrupted)."""
        return not self.state.interrupted

    def wait_for_interruption(self, timeout: Optional[float] = None) -> bool:
        """Wait for interruption signal, with optional timeout."""
        start_time = time.time()
        while not self.state.interrupted:
            if timeout and (time.time() - start_time) > timeout:
                return False
            time.sleep(0.1)
        return True

    def _perform_graceful_shutdown(self) -> None:
        """Perform the actual graceful shutdown procedures."""
        if self.state.shutdown_initiated:
            return

        with self.shutdown_lock:
            self.state.shutdown_initiated = True

            self.console.print("[blue]🛑 Cleaning up resources...[/blue]")

            # 1. Call cleanup callbacks first
            self._execute_cleanup_callbacks()

            # 2. Shutdown thread pools
            self._shutdown_executors()

            # 3. Wait for active threads to finish (with timeout)
            self._wait_for_threads()

            # 4. Display summary
            self._display_interruption_summary()

            self.state.cleanup_completed = True
            self.console.print("[green]✅ Graceful shutdown completed[/green]")

    def _execute_cleanup_callbacks(self) -> None:
        """Execute registered cleanup callbacks."""
        if not self.state.cleanup_callbacks:
            return

        self.console.print("[blue]🧹 Running cleanup tasks...[/blue]")

        for i, callback in enumerate(self.state.cleanup_callbacks):
            try:
                self.console.print(f"[dim]  Running cleanup task {i+1}/{len(self.state.cleanup_callbacks)}...[/dim]")
                callback()
            except Exception as e:
                self.console.print(f"[red]⚠️ Cleanup task {i+1} failed: {e}[/red]")

    def _shutdown_executors(self) -> None:
        """Shutdown registered thread pool executors."""
        if not self.state.active_executors:
            return

        self.console.print(f"[blue]🔄 Shutting down {len(self.state.active_executors)} thread pools...[/blue]")

        for i, executor in enumerate(self.state.active_executors):
            try:
                self.console.print(f"[dim]  Shutting down thread pool {i+1}...[/dim]")
                executor.shutdown(wait=False)  # Don't wait to avoid hanging

                # Give threads a moment to exit gracefully
                time.sleep(0.1)

            except Exception as e:
                self.console.print(f"[red]⚠️ Thread pool {i+1} shutdown failed: {e}[/red]")

    def _wait_for_threads(self) -> None:
        """Wait for active threads to finish with timeout."""
        if not self.state.active_threads:
            return

        self.console.print(f"[blue]⏳ Waiting for {len(self.state.active_threads)} active threads...[/blue]")

        # Filter to only include threads that are still alive
        active_threads = [t for t in self.state.active_threads if t.is_alive()]

        if not active_threads:
            return

        # Wait with timeout - shorter to prevent hanging
        timeout = 2.0  # 2 seconds timeout to prevent hanging
        start_time = time.time()

        for thread in active_threads:
            remaining_time = timeout - (time.time() - start_time)
            if remaining_time <= 0:
                break

            try:
                thread.join(timeout=min(remaining_time, 0.5))  # Max 0.5s per thread
            except Exception:
                pass  # Ignore join errors

        # Check for threads that didn't finish
        still_active = [t for t in active_threads if t.is_alive()]
        if still_active:
            self.console.print(f"[yellow]⚠️ {len(still_active)} thread(s) did not finish in time[/yellow]")
            self.console.print("[yellow]→ Forcing immediate exit to prevent hanging[/yellow]")
            # Force exit if threads are hanging
            import os
            os._exit(1)

    def _display_interruption_summary(self) -> None:
        """Display summary of progress at time of interruption."""
        self.console.print("\n[bold cyan]📊 Download Interruption Summary:[/bold cyan]")

        if not self.progress_data:
            self.console.print("[yellow]No progress data available[/yellow]")
            return

        total_completed = sum(data['completed'] for data in self.progress_data.values())
        total_total = sum(data['total'] for data in self.progress_data.values())

        self.console.print(f"📹 Videos processed: {total_completed} of {total_total}")

        if self.progress_data:
            self.console.print("\n[channel details:")
            for channel, data in self.progress_data.items():
                completed = data['completed']
                total = data['total']
                percentage = (completed / total * 100) if total > 0 else 0
                self.console.print(f"  • {channel}: {completed}/{total} ({percentage:.1f}%)")

        if self.state.interruption_time:
            elapsed = time.time() - self.state.interruption_time
            self.console.print(f"\n⏱️ Graceful shutdown took {elapsed:.1f} seconds")

    @contextmanager
    def protected_operation(self, operation_name: str):
        """
        Context manager for protecting specific operations from interruption.

        Args:
            operation_name: Name of the operation for logging purposes
        """
        if self.check_interruption():
            raise InterruptedError(f"Operation '{operation_name}' cancelled due to interruption")

        try:
            yield
        except InterruptedError:
            self.console.print(f"[yellow]⚠️ Operation '{operation_name}' was interrupted[/yellow]")
            raise
        except Exception as e:
            if self.check_interruption():
                self.console.print(f"[yellow]⚠️ Operation '{operation_name}' failed due to interruption[/yellow]")
            raise


# Global instance for easy access
_global_handler: Optional[GracefulInterruptHandler] = None


def get_global_interrupt_handler() -> GracefulInterruptHandler:
    """Get or create the global interrupt handler."""
    global _global_handler
    if _global_handler is None:
        _global_handler = GracefulInterruptHandler()
    return _global_handler


def register_executor(executor: ThreadPoolExecutor) -> None:
    """Register an executor for global cleanup."""
    get_global_interrupt_handler().state.add_executor(executor)


def register_thread(thread: threading.Thread) -> None:
    """Register a thread for global tracking."""
    get_global_interrupt_handler().state.add_thread(thread)


def register_cleanup_callback(callback: Callable) -> None:
    """Register a cleanup callback globally."""
    get_global_interrupt_handler().state.add_cleanup_callback(callback)


def update_progress(channel: str, completed: int, total: int, video_id: Optional[str] = None) -> None:
    """Update progress in the global handler."""
    get_global_interrupt_handler().state.update_progress(channel, completed, total, video_id)


def check_interruption() -> bool:
    """Check if interruption has been requested globally."""
    return get_global_interrupt_handler().check_interruption()


def should_continue() -> bool:
    """Check if operations should continue globally."""
    return get_global_interrupt_handler().should_continue()